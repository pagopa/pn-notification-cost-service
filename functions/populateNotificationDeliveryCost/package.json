  "scripts": {
    "test-build": "npm run-script test && npm run-script coverage && npm run-script sonar && npm run-script build",
    "build": "npm prune --production && rm -f ./function.zip && zip -r ./function.zip . -x './src/test/*' -x '*.md' -x '*.env'  -x './coverage/*' -x './.nyc_output/*' -x './.scannerwork/*'",
    "test": "nyc --reporter=html --reporter=text mocha './src/test/**/*.test.js' --recursive --timeout=3000 --exit -r dotenv/config dotenv_config_path=../migration/src/config/.env",
    "coverage": "nyc report --reporter=lcov",
    "sonar": "node sonarqube-scanner.js -Dsonar.login=${SONAR_TOKEN}",
    "env": "node -r dotenv/config index.js dotenv_config_path=../migration/src/config/.env"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^2.0.1",
    "axios-mock-adapter": "^2.1.0",
    "chai": "^4.3.6",
    "dotenv": "^16.0.3",
    "eslint": "^8.23.1",
    "eslint-plugin-import": "^2.26.0",
    "lambda-tester": "^4.0.1",
    "mocha": "^9.2.2",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.0",
    "sonarqube-scanner": "^3.3.0"
  },
